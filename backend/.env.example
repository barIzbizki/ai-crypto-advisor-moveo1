# Copy to .env for local development. All values below are safe local defaults.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string.
# Matches the local dev database defined in docker-compose.yml (host port 5434,
# chosen to avoid colliding with other projects' Postgres instances on this
# machine, e.g. ports 5432/5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/moveo1

# Origin allowed to make cross-origin requests to this API (CORS).
# Matches the frontend's default local Vite dev server origin.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign auth JWTs. Required in production; a local-only
# insecure default is used in development if unset.
JWT_SECRET=dev-only-insecure-secret-do-not-use-in-production

# CryptoPanic API key for the Market News section. Optional — if unset, the
# section falls back to a static headline list instead of calling the API.
CRYPTOPANIC_API_KEY=

# Base URL for the CryptoPanic API. Optional — defaults to the public API.
CRYPTOPANIC_API_BASE_URL=https://cryptopanic.com/api/v1

# CoinGecko Demo API key for the Coin Prices section. Optional — if unset,
# requests use CoinGecko's shared anonymous rate limit instead of the key's
# dedicated Demo-tier limit.
COINGECKO_API_KEY=
