# Copy to .env for local development. All values below are safe local defaults.

# development | test | production
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# PostgreSQL connection string.
# Matches the local dev database defined in docker-compose.yml (host port 5434,
# chosen to avoid colliding with other projects' Postgres instances on this
# machine, e.g. ports 5432/5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5434/moveo1

# Origin allowed to make cross-origin requests to this API (CORS).
# Matches the frontend's default local Vite dev server origin.
CORS_ORIGIN=http://localhost:5173
